meta {
  name: Invalid missing telefono
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/lead
  body: json
  auth: none
}

headers {
  content-type: application/json
}

body:json {
  {
    "nombre": "Test User",
    "paquete": "pro"
  }
}

tests {
  test("returns 400 Bad Request", function() {
    expect(res.status).to.equal(400);
  });

  test("reports telefono validation error", function() {
    expect(res.body.errors).to.be.an("array");
    const fields = res.body.errors.map((e) => e.field);
    expect(fields).to.include("telefono");
  });
}

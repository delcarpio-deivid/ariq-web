meta {
  name: Invalid phone not Peru
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/lead
  body: json
  auth: none
}

headers {
  content-type: application/json
}

body:json {
  {
    "nombre": "Test User",
    "telefono": "5551234567",
    "paquete": "pro"
  }
}

tests {
  test("returns 400 Bad Request", function() {
    expect(res.status).to.equal(400);
  });

  test("reports telefono Peru format error", function() {
    expect(res.body.errors).to.be.an("array");
    const telefonoError = res.body.errors.find((e) => e.field === "telefono");
    expect(telefonoError).to.exist;
    expect(telefonoError.message).to.include("Perú");
  });
}

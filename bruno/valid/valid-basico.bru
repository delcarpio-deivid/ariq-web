meta {
  name: Valid Basico
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/lead
  body: json
  auth: none
}

headers {
  content-type: application/json
}

body:json {
  {
    "nombre": "Carlos Ruiz",
    "telefono": "912345678",
    "paquete": "basico"
  }
}

tests {
  test("returns 202 Accepted", function() {
    expect(res.status).to.equal(202);
  });

  test("includes whatsappUrl with paquete Basico", function() {
    expect(res.body.whatsappUrl).to.be.a("string");
    const decoded = decodeURIComponent(res.body.whatsappUrl);
    expect(decoded).to.include("Carlos Ruiz");
    expect(decoded).to.include("paquete Básico");
  });
}
